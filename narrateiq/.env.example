# ============================================================
# NarrateIQ — Environment Variables
# Copy to .env.local and fill in all values before running.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase ---
# Found at: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- Database (Supabase Postgres direct connection) ---
# Found at: https://supabase.com/dashboard/project/<id>/settings/database
DATABASE_URL=postgresql://postgres:<password>@db.<project-id>.supabase.co:5432/postgres

# --- Anthropic ---
# Found at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Stripe ---
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Rate Limiting ---
# Max AI requests per user per hour
AI_RATE_LIMIT_RPH=20

# --- File Upload ---
# Max upload size in bytes (default 10MB)
MAX_UPLOAD_BYTES=10485760
# Comma-separated allowed MIME types
ALLOWED_MIME_TYPES=text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/pdf

# --- Supabase Storage ---
SUPABASE_STORAGE_BUCKET=financial-uploads
