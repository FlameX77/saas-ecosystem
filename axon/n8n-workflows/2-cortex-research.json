    "🧠 Claude: Score Lead": {"main": [[{"node": "📎 Attach Score to Contact","type": "main","index": 0}]]},
    "🤖 Claude Sonnet": {"ai_languageModel": [[{"node": "🧠 Claude: Score Lead","type": "ai_languageModel","index": 0}]]},
    "📊 Parse Score JSON": {"ai_outputParser": [[{"node": "🧠 Claude: Score Lead","type": "ai_outputParser","index": 0}]]},
