    "✂️ Split Into Individual Leads": {"main": [[{"node": "📋 Extract Contact Data","type": "main","index": 0}]]},
    "📋 Extract Contact Data": {"main": [[{"node": "❓ Needs Email Verification?","type": "main","index": 0}]]},
