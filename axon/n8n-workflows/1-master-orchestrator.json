    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst agent = (body.agent || 'cortex').toLowerCase();\nconst userId = body.userId || body.email || 'anonymous';\nconst payload = body.payload || body;\n\nif (!['cortex','specter','striker','pulse','sentinel'].includes(agent)) {\n  throw new Error(`Unknown agent: ${agent}. Use cortex, specter, striker, pulse, or sentinel`);\n}\n\nreturn [{\n  json: {\n    agent,\n    userId,\n    payload,\n    timestamp: new Date().toISOString(),\n    requestId: Math.random().toString(36).substr(2,9)\n  }\n}];"
      },
      "id": "validate-input",
      "name": "✅ Validate & Route Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, -60]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {"conditions": {"options": {"caseSensitive": false},"combinator": "and","conditions": [{"leftValue": "={{ $json.agent }}","operator": {"type": "string","operation": "equals"},"rightValue": "cortex"}]},"renameOutput": true,"outputKey": "cortex"},
            {"conditions": {"options": {"caseSensitive": false},"combinator": "and","conditions": [{"leftValue": "={{ $json.agent }}","operator": {"type": "string","operation": "equals"},"rightValue": "specter"}]},"renameOutput": true,"outputKey": "specter"},
            {"conditions": {"options": {"caseSensitive": false},"combinator": "and","conditions": [{"leftValue": "={{ $json.agent }}","operator": {"type": "string","operation": "equals"},"rightValue": "striker"}]},"renameOutput": true,"outputKey": "striker"},
            {"conditions": {"options": {"caseSensitive": false},"combinator": "and","conditions": [{"leftValue": "={{ $json.agent }}","operator": {"type": "string","operation": "equals"},"rightValue": "pulse"}]},"renameOutput": true,"outputKey": "pulse"},
            {"conditions": {"options": {"caseSensitive": false},"combinator": "and","conditions": [{"leftValue": "={{ $json.agent }}","operator": {"type": "string","operation": "equals"},"rightValue": "sentinel"}]},"renameOutput": true,"outputKey": "sentinel"}
          ]
        },
        "options": {}
      },
